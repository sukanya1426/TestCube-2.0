# --- secrets (never commit) ---
.env
.env.*
!.env.example
*.pem
*.key
google_api_key*
credentials.json
service-account*.json

# --- APKs and Android packages ---
# Keep the apks/ folder via .gitkeep; binaries stay local.
*.apk
*.apks
*.aab
*.xapk
*.apk.bak
!apks/.gitkeep

# --- run artifacts (large; regenerate with droidbot) ---
output/
output_dir
outputDir*
droidbot_output
**/feature_test/session.json.bak

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
.Python
.venv/
venv/
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*,cover

# --- installers / packaging noise ---
*.manifest
*.spec
pip-log.txt
pip-delete-this-directory.txt

# --- logs and backups ---
*.log
*.txt.bak
docs/_build/

# --- OS / IDE ---
.DS_Store
.idea/
.vscode/
*.swp
*~

